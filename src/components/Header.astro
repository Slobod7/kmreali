---
import logo from '../assets/brand/kmreali-logo-dark.svg';
import { nav, url } from '../site';

const current = Astro.url.pathname;
---

<header class="antet">
  <div class="container antet__rand">
    <a class="antet__logo" href={url()} rel="home">
      <img src={logo.src} alt="KM Reali" width="146" height="46" />
    </a>
    <nav aria-label="Meniu principal">
      <ul>
        {
          nav.map((item) => {
            const href = url(item.href);
            return (
              <li>
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .antet {
    background: var(--carbune);
    color: var(--hartie);
    border-bottom: 4px solid var(--rosu);
  }
  .antet__rand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
  }
  .antet__logo { display: inline-flex; line-height: 0; }
  .antet__logo img { height: 46px; width: auto; }

  ul {
    display: flex;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--hartie);
    text-decoration: none;
    font-family: var(--font-titlu);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--alb);
    text-decoration: underline;
    text-decoration-color: var(--rosu);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }

  @media (max-width: 34rem) {
    .antet__rand { padding-block: 0.875rem 0.75rem; }
    .antet__logo img { height: 40px; }
    nav { width: 100%; }
    ul { justify-content: space-between; }
  }
</style>
