---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import logo from '../assets/brand/kmreali-logo.svg';
import { articleUrl, getArticles } from '../articles';
import { site, url } from '../site';

const allArticles = await getArticles();
const articles = allArticles.slice(0, 9);

// The budget buttons open the search in Mașini fiabile with that budget already set (see src/components/Widgeturi.astro).
// The amounts match the article's budget headings; under 10.000 € the search finds only one to three cars.
const reliableCars = allArticles.find((article) => article.id === 'masini-fiabile');
const budgets = [10000, 15000, 20000, 30000];
const euro = new Intl.NumberFormat('ro-RO');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: Astro.site?.href,
    inLanguage: 'ro-RO',
    description: site.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: Astro.site?.href,
    logo: new URL(logo.src, Astro.site).href,
  },
];
---

<Base jsonLd={jsonLd}>
  <section class="erou">
    <div class="container erou__rand">
      <h1 class="erou__titlu">{site.tagline}</h1>
      <p class="erou__intro">
        Recenzii scrise de proprietar. Nu după o zi de test drive, ci după luni de drumuri, plinuri și vizite la service.
        Ghiduri și topuri făcute pe date publice și păreri de la proprietari, cu surse.
      </p>
      <p class="erou__actiuni">
        <a class="buton" href={url('recenzii/')}>Citește recenziile</a>
        <a class="erou__despre" href={url('despre/')}>De ce „km reali”</a>
      </p>

      <!-- The roadside marker from the logo, planted on the ground line under the hero. -->
      <div class="stalp">
        <span class="stalp__cap" aria-hidden="true">km</span>
        <ul class="stalp__lista" aria-label="Ce afli din fiecare recenzie">
          <li>Consum real</li>
          <li>Probleme reale</li>
          <li>Costuri reale</li>
        </ul>
      </div>
    </div>
  </section>

  {
    reliableCars && (
      <section class="container buget" aria-labelledby="buget-titlu">
        <div class="buget__card">
          <div class="buget__text">
            <h2 id="buget-titlu">Ce mașină fiabilă iei cu bugetul tău?</h2>
            <p>
              Alege suma și vezi modelele din <a href={articleUrl(reliableCars)}>{reliableCars.data.title.split(' – ')[0]}</a>:
              noi sau second hand, cele care ies bine la TÜV, ADAC și What Car?, cu prețuri din România.
            </p>
          </div>
          <div class="buget__alegere">
            <p class="buget__eticheta" id="buget-eticheta">Buget maxim</p>
            <ul class="buget__optiuni" aria-labelledby="buget-eticheta">
              {budgets.map((budget) => (
                <li>
                  <a href={`${articleUrl(reliableCars)}?buget=${budget}#caută-după-buget`}>
                    <span>până la</span> {euro.format(budget)} €
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="container noutati" aria-labelledby="noutati-titlu">
    <h2 id="noutati-titlu">Cele mai noi articole</h2>
    {
      articles.length > 0 ? (
        <ul class="grila-articole">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </ul>
      ) : (
        <p class="gol">Primele articole apar în curând.</p>
      )
    }
  </section>
</Base>

<style>
  /* The bottom border is the ground the marker stands on. */
  .erou { border-bottom: 4px solid var(--carbune); }

  /* Phones: text on top, the button and the marker share the last row. */
  .erou__rand {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'titlu titlu'
      'intro intro'
      'actiuni stalp';
    column-gap: 1.25rem;
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .erou__titlu { grid-area: titlu; font-size: clamp(2.6rem, 1.4rem + 4.6vw, 6rem); max-width: 11em; }
  .erou__intro {
    grid-area: intro;
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: var(--text-mare);
    line-height: 1.45;
    color: var(--grafit);
  }
  .erou__actiuni {
    grid-area: actiuni;
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 1.75rem 2.25rem;
  }
  .erou__despre {
    font-weight: 600;
    text-decoration-color: var(--rosu);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .buton {
    display: inline-block;
    padding: 0.6rem 1.25rem 0.65rem;
    background: var(--carbune);
    color: var(--hartie);
    border-radius: 4px;
    font-family: var(--font-titlu);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .buton:hover { background: var(--rosu); color: var(--alb); }

  /* The marker: same shape as the logo and the km badge on cards, sized in em so it scales as one piece. */
  .stalp {
    grid-area: stalp;
    align-self: end;
    width: 9.5em;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    background: var(--alb);
    border: 4px solid var(--carbune);
    border-bottom: 0;
    border-radius: 4.75em 4.75em 0 0;
    overflow: hidden;
    font-family: var(--font-titlu);
    text-align: center;
    line-height: 1.1;
  }
  .stalp__cap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 3.9em;
    padding-bottom: 0.3em;
    background: var(--rosu);
    color: var(--alb);
    font-size: 1.5em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stalp__lista { list-style: none; margin: 0; padding: 0.5em 0.6em 1.4em; }
  .stalp__lista li {
    padding-block: 0.55em;
    font-size: 1.2em;
    font-weight: 700;
    color: var(--carbune);
  }
  .stalp__lista li + li { border-top: 1px solid var(--nisip); }

  /* Wide screens: text on the left, a tall marker on the right. */
  @media (min-width: 48rem) {
    .erou__rand {
      grid-template-areas:
        'titlu stalp'
        'intro stalp'
        'actiuni stalp';
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2rem, 6vw, 6rem);
    }
    .erou__actiuni { padding-block: 2rem clamp(2.5rem, 5vw, 4rem); }
    .stalp { margin-top: 0; font-size: clamp(1.15rem, 0.1rem + 1.9vw, 2.1rem); }
  }

  /* The way into Mașini fiabile by budget: a card like the search it opens, with one button per amount. */
  .buget { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .buget__card {
    display: grid;
    gap: 1.5rem;
    background: var(--alb);
    border: 1px solid var(--nisip);
    border-radius: 8px;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .buget__text { display: grid; gap: 0.6rem; max-width: 36rem; }
  .buget__text p { color: var(--grafit); }
  .buget__text a { font-weight: 600; text-decoration-color: var(--rosu); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .buget__eticheta { margin-bottom: 0.5rem; font-family: var(--font-titlu); font-weight: 700; font-size: var(--text-mediu); }
  .buget__optiuni {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .buget__optiuni a {
    display: grid;
    justify-items: center;
    padding: 0.55rem 0.75rem 0.65rem;
    border: 2px solid var(--carbune);
    border-radius: 6px;
    background: var(--hartie);
    font-family: var(--font-titlu);
    font-weight: 800;
    font-size: var(--text-mare);
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
  }
  .buget__optiuni a span { font-family: var(--font-text); font-weight: 400; font-size: var(--text-mic); color: var(--gri); }
  .buget__optiuni a:hover { border-color: var(--rosu); }

  /* Wide screens: the text on the left, the four amounts in one row on the right. */
  @media (min-width: 60rem) {
    .buget__card { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: clamp(2rem, 5vw, 4rem); }
    .buget__optiuni { grid-template-columns: repeat(4, minmax(6.5rem, auto)); }
  }

  .noutati { display: grid; gap: 1.5rem; padding-top: clamp(2.5rem, 6vw, 4rem); }
</style>
