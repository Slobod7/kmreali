---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FisaMasinii from '../../components/FisaMasinii.astro';
import Cuprins from '../../components/Cuprins.astro';
import InapoiSus from '../../components/InapoiSus.astro';
import Widgeturi from '../../components/Widgeturi.astro';
import logo from '../../assets/brand/kmreali-logo.svg';
import { articleUrl, faq, getArticles, readingMinutes, reviewSummary, textWithLinks, type Article } from '../../articles';
import { categories, formatDate, site, url } from '../../site';

// Articles live under their section: /recenzii/<slug>/, /ghiduri/<slug>/, /topuri/<slug>/.
export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, i) => ({
    params: { category: article.data.category, slug: article.id },
    props: { article, newer: articles[i - 1], older: articles[i + 1] },
  }));
}

interface Props {
  article: Article;
  newer?: Article;
  older?: Article;
}

const { article, newer, older } = Astro.props;
const { title, seoTitle, description, date, updated, category, cover, coverAlt, coverCredit, masina, draft } = article.data;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const hasSidebar = Boolean(masina) || sections.length > 0;
const minutes = readingMinutes(article.body);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const coverUrl = new URL(cover.src, Astro.site).href;
const author = { '@type': 'Person', name: site.author.name, url: new URL(url('despre/'), Astro.site).href };
const questions = faq(article.body);
const verdict = category === 'recenzii' ? reviewSummary(article.body) : undefined;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: coverUrl,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    inLanguage: 'ro-RO',
    mainEntityOfPage: pageUrl,
    author,
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: new URL(logo.src, Astro.site).href } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL(url(), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: categories[category].title, item: new URL(url(`${category}/`), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];

// Reviews: the car from `masina`, with the score, likes and dislikes from the "Pe scurt" list.
if (masina && verdict && (verdict.rating || verdict.pros.length || verdict.cons.length)) {
  const notes = (items: string[]) =>
    items.length ? { '@type': 'ItemList', itemListElement: items.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })) } : undefined;

  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': ['Product', 'Car'],
    name: masina.model,
    image: coverUrl,
    vehicleModelDate: masina.an?.toString(),
    vehicleEngine: masina.motor ? { '@type': 'EngineSpecification', name: masina.motor } : undefined,
    driveWheelConfiguration: masina.tractiune,
    vehicleTransmission: masina.cutie,
    bodyType: masina.caroserie,
    mileageFromOdometer: masina.kilometraj ? { '@type': 'QuantitativeValue', value: masina.kilometraj, unitCode: 'KMT' } : undefined,
    review: {
      '@type': 'Review',
      name: title,
      url: pageUrl,
      inLanguage: 'ro-RO',
      datePublished: date.toISOString(),
      author,
      reviewRating: verdict.rating
        ? { '@type': 'Rating', ratingValue: verdict.rating.value, bestRating: verdict.rating.best, worstRating: 1 }
        : undefined,
      positiveNotes: notes(verdict.pros),
      negativeNotes: notes(verdict.cons),
    },
  });
}

if (questions.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'ro-RO',
    mainEntity: questions.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  });
}
---

<Base
  title={title}
  seoTitle={seoTitle}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  published={date}
  modified={updated}
  noindex={draft}
  jsonLd={jsonLd}
>
  <article>
    <header class="container articol-antet">
      {draft && <p class="ciorna">Ciornă: se vede doar pe calculatorul tău, nu și pe site.</p>}
      <a class="categorie" href={url(`${category}/`)}>{categories[category].singular}</a>
      <h1>{title}</h1>
      <p class="articol-meta">
        <span>De <a href={url('despre/#autor')}>{site.author.name}</a></span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Actualizat pe <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        <span>{minutes} min de citit</span>
      </p>
    </header>

    <div class="container">
      <figure class="articol-figura">
        <Image class="articol-coperta" src={cover} alt={coverAlt} priority widths={[640, 960, 1280, 1600]} sizes="(min-width: 75rem) 75rem, 100vw" />
        {coverCredit && <figcaption set:html={textWithLinks(coverCredit)} />}
      </figure>
    </div>

    <div class:list={['container', 'articol-corp', { 'are-lateral': hasSidebar }]}>
      <div class="coloana">
        {sections.length > 0 && <Cuprins headings={sections} pliat />}
        <div class="text">
          <Content />
        </div>
      </div>

      {
        hasSidebar && (
          <div class="lateral">
            {masina && <FisaMasinii masina={masina} />}
            {sections.length > 0 && <Cuprins headings={sections} />}
          </div>
        )
      }

      <footer class="articol-subsol">
        <section class="autor" aria-label="Despre autor">
          <p class="autor__eticheta">Despre autor</p>
          <p class="autor__nume"><a href={url('despre/#autor')}>{site.author.name}</a></p>
          <p>{site.author.bio}</p>
        </section>

        {
          (newer || older) && (
            <nav class="vecini" aria-label="Alte articole">
              {older && (
                <a href={articleUrl(older)}>
                  <span>Articolul anterior</span>
                  {older.data.title}
                </a>
              )}
              {newer && (
                <a href={articleUrl(newer)}>
                  <span>Articolul următor</span>
                  {newer.data.title}
                </a>
              )}
            </nav>
          )
        }
      </footer>
    </div>
  </article>

  <InapoiSus />
  {article.body?.includes('data-widget=') && <Widgeturi />}
</Base>

<style>
  .articol-antet {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  .articol-antet h1 { max-width: 18em; }
  .articol-meta { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; color: var(--gri); font-size: var(--text-mic); }
  .articol-meta a, .autor__nume a { text-decoration-color: var(--rosu); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .ciorna {
    font-family: var(--font-titlu);
    font-weight: 700;
    color: var(--rosu);
    border: 2px solid currentColor;
    border-radius: 4px;
    padding: 0.2em 0.6em;
  }

  .articol-figura { margin: 0; }
  :global(.articol-coperta) { width: 100%; border-radius: 8px; aspect-ratio: 16 / 9; object-fit: cover; }
  .articol-figura figcaption { margin-top: 0.5rem; color: var(--gri); font-size: var(--text-mic); font-style: italic; line-height: 1.45; }
  .articol-figura figcaption :global(a) { text-decoration-color: var(--rosu); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .articol-corp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  .coloana, .articol-subsol, .lateral :global(.fisa) { max-width: var(--latime-text); }
  .articol-corp:not(.are-lateral) :is(.coloana, .articol-subsol) { width: 100%; margin-inline: auto; }

  /* Narrow screens: the contents fold into one line above the text and the car's card follows the text. */
  .coloana :global(.cuprins--pliat) { margin-bottom: 1.25rem; }
  .lateral { display: contents; }
  .lateral :global(.cuprins) { display: none; }

  /* Wide screens: the text takes the width the sidebar leaves, with a gap of at most 6.25rem.
     The car's card scrolls past with the text, then the contents stay in view until the end.
     The sidebar runs the full height of the article so the contents have room to stick. */
  @media (min-width: 64rem) {
    .are-lateral { grid-template-columns: minmax(0, 1fr) 20rem; column-gap: clamp(2.5rem, 7vw, 6.25rem); }
    .are-lateral .coloana { grid-row: 1; grid-column: 1; max-width: none; }
    .are-lateral .articol-subsol { grid-row: 2; grid-column: 1; max-width: none; }
    .coloana :global(.cuprins--pliat) { display: none; }
    .lateral { display: grid; gap: 1rem; align-content: start; grid-row: 1 / span 2; grid-column: 2; }
    .lateral :global(.cuprins) { display: block; position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; }
  }

  /* With the 2.5rem gap above it, 3.5rem from the end of the text. */
  .articol-subsol { display: grid; gap: 2rem; margin-top: 1rem; }

  .autor {
    display: grid;
    gap: 0.25rem;
    background: var(--alb);
    border: 1px solid var(--nisip);
    border-radius: 8px;
    padding: 1.5rem;
    font-size: 1rem;
  }
  .autor__eticheta { font-family: var(--font-titlu); font-weight: 700; color: var(--rosu); font-size: var(--text-mic); }
  .autor__nume { font-family: var(--font-titlu); font-weight: 700; font-size: var(--text-mare); line-height: 1.2; }

  .vecini { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .vecini a { display: grid; gap: 0.25rem; text-decoration: none; font-family: var(--font-titlu); font-weight: 700; font-size: var(--text-mare); line-height: 1.15; }
  .vecini span { font-family: var(--font-text); font-weight: 400; font-size: var(--text-mic); color: var(--gri); }

  /* Article text */
  .text :global(> * + *) { margin-top: 1.25em; }
  .text :global(h2) { margin-top: 2.2em; font-size: clamp(1.6rem, 1.4rem + 0.9vw, 2.1rem); scroll-margin-top: 1.5rem; }
  .text :global(h3) { margin-top: 1.8em; }
  .text :global(h2 + *), .text :global(h3 + *) { margin-top: 0.75em; }
  .text :global(a) { text-decoration-color: var(--rosu); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .text :global(a:hover) { color: var(--carbune); background: var(--evidentiator); }
  .text :global(img) { width: 100%; border-radius: 6px; }
  .text :global(ul), .text :global(ol) { padding-left: 1.25em; }
  .text :global(li + li) { margin-top: 0.4em; }
  .text :global(li::marker) { color: var(--rosu); }
  .text :global(blockquote) { margin-inline: 0; padding-left: 1.25rem; border-left: 4px solid var(--rosu); color: var(--grafit); }
  .text :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95em; background: var(--alb); }
  /* A long word in a cell can carry a soft hyphen (&shy;): it only breaks there on a phone, so wider screens keep the table as it is. */
  .text :global(th), .text :global(td) { border: 1px solid var(--nisip); padding: 0.6em 0.85em; text-align: left; vertical-align: top; line-height: 1.4; hyphens: none; }
  @media (max-width: 30rem) {
    .text :global(table) { font-size: 0.875em; }
    .text :global(th), .text :global(td) { padding: 0.5em 0.55em; hyphens: manual; }
    /* Four columns don't always fit a phone: the table scrolls sideways on its own, not the whole page. */
    .text :global(> table:has(th:nth-child(4))) { display: block; overflow-x: auto; }
  }
  .text :global(th) { background: var(--carbune); color: var(--hartie); font-family: var(--font-titlu); font-weight: 600; letter-spacing: 0.03em; }
  .text :global(tbody tr:nth-child(even) td) { background: #faf8f4; }
  /* A small symbol at the start of a cell, such as a warning light, sits above the cell's text. */
  .text :global(td img) { width: 2.75rem; border-radius: 0.6rem; margin-bottom: 0.4em; }
  .text :global(hr) { border: 0; border-top: 1px solid var(--nisip); margin-block: 2.5em; }

  /* FAQ: the questions are styled in global.css. Here they only drop the space the text puts between blocks. */
  .text :global(.intrebare + .intrebare) { margin-top: 0; }
</style>
